  "points": [
    {
      "debateScope": "general",
      "bio": "T000467",
      "speaker": "Glenn Thompson",
      "side": "Yea",
      "manager": true,
      "url": "https://www.govinfo.gov/content/pkg/CREC-2026-04-29/html/CREC-2026-04-29-pt1-PgH3169.htm",
      "start": 62339,
      "quote": "I hear about trade. Trade is the Ways and Means Committee. I will say \nwe did double foreign market development and market access program, \nwhich are tools to help our farmers get access to trade, but we don't \nhave trade itself in our jurisdiction.",
      "display": "I hear about trade. Trade is the Ways and Means Committee. I will say we did double foreign market development and market access program, which are tools to help our farmers get access to trade, but we don't have trade itself in our jurisdiction.",
      "passageUrl": "https://www.govinfo.gov/content/pkg/CREC-2026-04-29/html/CREC-2026-04-29-pt1-PgH3169.htm#:~:text=I%20hear%20about%20trade.%20Trade%20is%20the%20Ways%20and%20Means%20Committee.%20I%20will%20say%20we%20did%20double%20foreign%20market%20development%20and%20market%20access%20program%2C%20which%20are%20tools%20to%20help%20our%20farmers%20get%20access%20to%20trade%2C%20but%20we%20don%27t%20have%20trade%20itself%20in%20our%20jurisdiction.",
      "end": 62588,
      "sentenceIds": [
        "45.21",
        "45.22",
        "45.23"
      ]
    },
    {
      "debateScope": "general",
      "bio": "L000491",
      "speaker": "Frank D. Lucas",
      "side": "Yea",
      "manager": false,
      "url": "https://www.govinfo.gov/content/pkg/CREC-2026-04-29/html/CREC-2026-04-29-pt1-PgH3169.htm",
      "start": 7499,
      "quote": "This bill will ensure that American farmers can continue to raise the \nfood and fiber that ultimately finds its way into your home, and it \nwill ensure that the next generation can continue that legacy.\n  I urge my colleagues to vote ``yes'' with me on final passage, and I \nthank Chairman Thompson for bringing forth this bill today.",
      "display": "This bill will ensure that American farmers can continue to raise the food and fiber that ultimately finds its way into your home, and it will ensure that the next generation can continue that legacy. I urge my colleagues to vote ``yes'' with me on final passage, and I thank Chairman Thompson for bringing forth this bill today.",
      "passageUrl": "https://www.govinfo.gov/content/pkg/CREC-2026-04-29/html/CREC-2026-04-29-pt1-PgH3169.htm#:~:text=This%20bill%20will%20ensure%20that%20American%20farmers%20can%20continue%20to%20raise%20the%20food%20and%20fiber%20that%20ultimately%20finds%20its%20way%20into%20your%20home%2C%20and%20it%20will%20ensure%20that%20the%20next%20generation%20can%20continue%20that%20legacy.%20I%20urge%20my%20colleagues%20to%20vote%20%60%60yes%27%27%20with%20me%20on%20final%20passage%2C%20and%20I%20thank%20Chairman%20Thompson%20for%20bringing%20forth%20this%20bill%20today.",
      "end": 7833,
      "sentenceIds": [
        "4.4",
        "4.5"
      ]
    },
    {
      "debateScope": "general",
      "bio": "P000597",
      "speaker": "Chellie Pingree",
      "side": "Nay",
      "manager": false,
      "url": "https://www.govinfo.gov/content/pkg/CREC-2026-04-29/html/CREC-2026-04-29-pt1-PgH3169.htm",
      "start": 17836,
      "quote": "As a \nresult of this bill, more people will go hungry, more farmers will lose \nassistance to the conservation programs that are already \noversubscribed, and more farmers who are struggling to make ends meet \nwill find it more and more difficult to hang on to their farms.",
      "display": "As a result of this bill, more people will go hungry, more farmers will lose assistance to the conservation programs that are already oversubscribed, and more farmers who are struggling to make ends meet will find it more and more difficult to hang on to their farms.",
      "passageUrl": "https://www.govinfo.gov/content/pkg/CREC-2026-04-29/html/CREC-2026-04-29-pt1-PgH3169.htm#:~:text=As%20a%20result%20of%20this%20bill%2C%20more%20people%20will%20go%20hungry%2C%20more%20farmers%20will%20lose%20assistance%20to%20the%20conservation%20programs%20that%20are%20already%20oversubscribed%2C%20and%20more%20farmers%20who%20are%20struggling%20to%20make%20ends%20meet%20will%20find%20it%20more%20and%20more%20difficult%20to%20hang%20on%20to%20their%20farms.",
      "end": 18107,
      "sentenceIds": [
        "13.2"
      ]
    },
    {
      "debateScope": "general",
      "bio": "T000487",
      "speaker": "Jill N. Tokuda",
      "side": "Nay",
      "manager": false,
      "url": "https://www.govinfo.gov/content/pkg/CREC-2026-04-29/html/CREC-2026-04-29-pt1-PgH3169.htm",
      "start": 23203,
      "quote": "Democrats fought to fix that. We pushed for an additional $10 billion \nin support so these farmers could survive and compete. We were blocked.",
      "display": "Democrats fought to fix that. We pushed for an additional $10 billion in support so these farmers could survive and compete. We were blocked.",
      "passageUrl": "https://www.govinfo.gov/content/pkg/CREC-2026-04-29/html/CREC-2026-04-29-pt1-PgH3169.htm#:~:text=Democrats%20fought%20to%20fix%20that.%20We%20pushed%20for%20an%20additional%20%2410%20billion%20in%20support%20so%20these%20farmers%20could%20survive%20and%20compete.%20We%20were%20blocked.",
