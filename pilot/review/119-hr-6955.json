  "points": [
    {
      "bio": "H001058",
      "speaker": "Bill Huizenga",
      "side": "Yea",
      "manager": false,
      "url": "https://www.govinfo.gov/content/pkg/CREC-2026-07-21/html/CREC-2026-07-21-pt1-PgH4707.htm",
      "start": 191715,
      "quote": "This bill lowers unnecessary regulatory costs for community and \nmidsize banks, not those big business center banks on Wall Street and \nin New York and around the world. In fact, this ends debanking. Mr. \nSpeaker, it restores the flexibility these institutions need to better \nserve you and your family.",
      "display": "This bill lowers unnecessary regulatory costs for community and midsize banks, not those big business center banks on Wall Street and in New York and around the world. In fact, this ends debanking. Mr. Speaker, it restores the flexibility these institutions need to better serve you and your family.",
      "passageUrl": "https://www.govinfo.gov/content/pkg/CREC-2026-07-21/html/CREC-2026-07-21-pt1-PgH4707.htm#:~:text=This%20bill%20lowers%20unnecessary%20regulatory%20costs%20for%20community%20and%20midsize%20banks%2C%20not%20those%20big%20business%20center%20banks%20on%20Wall%20Street%20and%20in%20New%20York%20and%20around%20the%20world.%20In%20fact%2C%20this%20ends%20debanking.%20Mr.%20Speaker%2C%20it%20restores%20the%20flexibility%20these%20institutions%20need%20to%20better%20serve%20you%20and%20your%20family.",
      "end": 192018,
      "sentenceIds": [
        "45.0",
        "45.1",
        "45.2"
      ]
    },
    {
      "bio": "M001204",
      "speaker": "Daniel Meuser",
      "side": "Yea",
      "manager": false,
      "url": "https://www.govinfo.gov/content/pkg/CREC-2026-07-21/html/CREC-2026-07-21-pt1-PgH4707.htm",
      "start": 203767,
      "quote": "I do rise in support of the very appropriately named Main Street \nCapital Access Act introduced by Chairman Hill and Subcommittee \nChairman Barr. The legislation does exactly what it says. It supports \naccess to capital for Main Street.",
      "display": "I do rise in support of the very appropriately named Main Street Capital Access Act introduced by Chairman Hill and Subcommittee Chairman Barr. The legislation does exactly what it says. It supports access to capital for Main Street.",
      "passageUrl": "https://www.govinfo.gov/content/pkg/CREC-2026-07-21/html/CREC-2026-07-21-pt1-PgH4707.htm#:~:text=I%20do%20rise%20in%20support%20of%20the%20very%20appropriately%20named%20Main%20Street%20Capital%20Access%20Act%20introduced%20by%20Chairman%20Hill%20and%20Subcommittee%20Chairman%20Barr.%20The%20legislation%20does%20exactly%20what%20it%20says.%20It%20supports%20access%20to%20capital%20for%20Main%20Street.",
      "end": 204003,
      "sentenceIds": [
        "87.0",
        "87.1",
        "87.2"
      ]
    },
    {
      "bio": "B001282",
      "speaker": "Andy Barr",
      "side": "Yea",
      "manager": false,
      "url": "https://www.govinfo.gov/content/pkg/CREC-2026-07-21/html/CREC-2026-07-21-pt1-PgH4707.htm",
      "start": 186563,
      "quote": "The Main Street Capital Access Act is about changing that. It is \nabout rightsizing this regulatory framework to ensure that community \nlenders get back to what they do best: serving their customers and \ntheir communities.",
      "display": "The Main Street Capital Access Act is about changing that. It is about rightsizing this regulatory framework to ensure that community lenders get back to what they do best: serving their customers and their communities.",
      "passageUrl": "https://www.govinfo.gov/content/pkg/CREC-2026-07-21/html/CREC-2026-07-21-pt1-PgH4707.htm#:~:text=The%20Main%20Street%20Capital%20Access%20Act%20is%20about%20changing%20that.%20It%20is%20about%20rightsizing%20this%20regulatory%20framework%20to%20ensure%20that%20community%20lenders%20get%20back%20to%20what%20they%20do%20best%3A%20serving%20their%20customers%20and%20their%20communities.",
      "end": 186785,
      "sentenceIds": [
        "30.0",
        "30.1"
      ]
    },
    {
      "bio": "V000081",
      "speaker": "Nydia M. Velazquez",
      "side": "Nay",
      "manager": false,
      "url": "https://www.govinfo.gov/content/pkg/CREC-2026-07-21/html/CREC-2026-07-21-pt1-PgH4707.htm",
      "start": 189125,
      "quote": "Community banks and credit unions are the foundations of our \nfinancial system. As ranking member of the House Small Business \nCommittee, I understand better than most the role they play in our \ncommunities, offering small business loans, farm loans, and mortgages. \nThey are critical lifelines to our rural and underserved communities \nthat have been left behind by our biggest banks.",
      "display": "Community banks and credit unions are the foundations of our financial system. As ranking member of the House Small Business Committee, I understand better than most the role they play in our communities, offering small business loans, farm loans, and mortgages. They are critical lifelines to our rural and underserved communities that have been left behind by our biggest banks.",
      "passageUrl": "https://www.govinfo.gov/content/pkg/CREC-2026-07-21/html/CREC-2026-07-21-pt1-PgH4707.htm#:~:text=Community%20banks%20and%20credit%20unions%20are%20the%20foundations%20of%20our%20financial%20system.%20As%20ranking%20member%20of%20the%20House%20Small%20Business%20Committee%2C%20I%20understand%20better%20than%20most%20the%20role%20they%20play%20in%20our%20communities%2C%20offering%20small%20business%20loans%2C%20farm%20loans%2C%20and%20mortgages.%20They%20are%20critical%20lifelines%20to%20our%20rural%20and%20underserved%20communities%20that%20have%20been%20left%20behind%20by%20our%20biggest%20banks.",
      "end": 189510,
      "sentenceIds": [
        "36.0",
        "36.1",
        "36.2"
      ]
    },
    {
      "bio": "W000187",
      "speaker": "Maxine Waters",
      "side": "Nay",
      "manager": false,
      "url": "https://www.govinfo.gov/content/pkg/CREC-2026-07-21/html/CREC-2026-07-21-pt1-PgH4707.htm",
      "start": 193834,
      "quote": "My bill eased the requirements on new banks. H.R. 6955, \nhowever, would set new banks up for failure. In fact, the bill \nundermines much of what we were trying to accomplish when we worked \ntogether in a bipartisan way.",
      "display": "My bill eased the requirements on new banks. H.R. 6955, however, would set new banks up for failure. In fact, the bill undermines much of what we were trying to accomplish when we worked together in a bipartisan way.",
      "passageUrl": "https://www.govinfo.gov/content/pkg/CREC-2026-07-21/html/CREC-2026-07-21-pt1-PgH4707.htm#:~:text=My%20bill%20eased%20the%20requirements%20on%20new%20banks.%20H.R.%206955%2C%20however%2C%20would%20set%20new%20banks%20up%20for%20failure.%20In%20fact%2C%20the%20bill%20undermines%20much%20of%20what%20we%20were%20trying%20to%20accomplish%20when%20we%20worked%20together%20in%20a%20bipartisan%20way.",
      "end": 194053,
      "sentenceIds": [
        "48.1",
        "48.2",
        "48.3"
      ]
    },
    {
      "bio": "G000587",
      "speaker": "Sylvia R. Garcia",
      "side": "Nay",
      "manager": false,
      "url": "https://www.govinfo.gov/content/pkg/CREC-2026-07-21/html/CREC-2026-07-21-pt1-PgH4707.htm",
      "start": 200719,
      "quote": "It does not help end the affordability crisis, feed hardworking \nAmericans, or keep a roof over their heads. Instead, this bill sneaks \nin deregulatory measures, further weakens the Consumer Financial \nProtection Bureau, and weakens community reinvestment and anti-\ndiscrimination safeguards.",
      "display": "It does not help end the affordability crisis, feed hardworking Americans, or keep a roof over their heads. Instead, this bill sneaks in deregulatory measures, further weakens the Consumer Financial Protection Bureau, and weakens community reinvestment and anti- discrimination safeguards.",
      "passageUrl": "https://www.govinfo.gov/content/pkg/CREC-2026-07-21/html/CREC-2026-07-21-pt1-PgH4707.htm#:~:text=It%20does%20not%20help%20end%20the%20affordability%20crisis%2C%20feed%20hardworking%20Americans%2C%20or%20keep%20a%20roof%20over%20their%20heads.%20Instead%2C%20this%20bill%20sneaks%20in%20deregulatory%20measures%2C%20further%20weakens%20the%20Consumer%20Financial%20Protection%20Bureau%2C%20and%20weakens%20community%20reinvestment%20and%20anti%2D%20discrimination%20safeguards.",
      "end": 201011,
      "sentenceIds": [
        "74.0",
        "74.1"
      ]
    }
