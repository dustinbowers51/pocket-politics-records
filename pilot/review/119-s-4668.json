  "points": [
    {
      "bio": "C001088",
      "speaker": "Christopher A. Coons",
      "side": "Yea",
      "manager": false,
      "url": "https://www.govinfo.gov/content/pkg/CREC-2026-09-28/html/CREC-2026-09-28-pt1-PgS5021-7.htm",
      "start": 52614,
      "quote": "This bill makes all of those protections real. In some ways, most \nimportantly, it enshrined in statute revenue sharing and NIL \ncompensation--name, image, and likeness compensation--for college \nathletes. It more than doubles money currently available for athletic \nprograms to share with student-athletes, and it has a $5 million fund \nfor women's and Olympic sports.",
      "display": "This bill makes all of those protections real. In some ways, most importantly, it enshrined in statute revenue sharing and NIL compensation--name, image, and likeness compensation--for college athletes. It more than doubles money currently available for athletic programs to share with student-athletes, and it has a $5 million fund for women's and Olympic sports.",
      "passageUrl": "https://www.govinfo.gov/content/pkg/CREC-2026-09-28/html/CREC-2026-09-28-pt1-PgS5021-7.htm#:~:text=This%20bill%20makes%20all%20of%20those%20protections%20real.%20In%20some%20ways%2C%20most%20importantly%2C%20it%20enshrined%20in%20statute%20revenue%20sharing%20and%20NIL%20compensation%2D%2Dname%2C%20image%2C%20and%20likeness%20compensation%2D%2Dfor%20college%20athletes.%20It%20more%20than%20doubles%20money%20currently%20available%20for%20athletic%20programs%20to%20share%20with%20student%2Dathletes%2C%20and%20it%20has%20a%20%245%20million%20fund%20for%20women%27s%20and%20Olympic%20sports.",
      "end": 52983,
      "sentenceIds": [
        "58.0",
        "58.1",
        "58.2"
      ]
    },
    {
      "bio": "B001288",
      "speaker": "Cory A. Booker",
      "side": "Nay",
      "manager": false,
      "url": "https://www.govinfo.gov/content/pkg/CREC-2026-09-28/html/CREC-2026-09-28-pt1-PgS5021-7.htm",
      "start": 72630,
      "quote": "It is a bill that was written without input from college athletes \nthemselves, whose lives will be directly affected. It violates a simple \nrule: nothing about us without us.",
      "display": "It is a bill that was written without input from college athletes themselves, whose lives will be directly affected. It violates a simple rule: nothing about us without us.",
      "passageUrl": "https://www.govinfo.gov/content/pkg/CREC-2026-09-28/html/CREC-2026-09-28-pt1-PgS5021-7.htm#:~:text=It%20is%20a%20bill%20that%20was%20written%20without%20input%20from%20college%20athletes%20themselves%2C%20whose%20lives%20will%20be%20directly%20affected.%20It%20violates%20a%20simple%20rule%3A%20nothing%20about%20us%20without%20us.",
