  "points": [
    {
      "bio": "V000133",
      "speaker": "Jefferson Van Drew",
      "side": "Yea",
      "manager": true,
      "url": "https://www.govinfo.gov/content/pkg/CREC-2026-09-16/html/CREC-2026-09-16-pt1-PgH5947.htm",
      "start": 8339,
      "quote": "For years and years, the American taxpayer has been treated like an \nopen ATM machine by sophisticated criminal syndicates, international \nfraudsters, and identity thieves. Billions of dollars intended for our \nmost vulnerable citizens, for our children, for the hungry, and for the \nunemployed have, instead, been stolen by criminals.",
      "summary": "For years and years, the American taxpayer has been treated like an open ATM machine by sophisticated criminal syndicates, international fraudsters, and identity thieves. Billions of dollars intended for our most vulnerable citizens, for our children, for the hungry, and for the unemployed have, instead, been stolen by criminals.",
      "index": 2
    },
    {
      "bio": "R000606",
      "speaker": "Jamie Raskin",
      "side": "Nay",
      "manager": true,
      "url": "https://www.govinfo.gov/content/pkg/CREC-2026-09-16/html/CREC-2026-09-16-pt1-PgH5947.htm",
      "start": 12187,
      "quote": "However, I rise in vehement opposition to H.R. 10326, the so-called \nPROOF Act, which is a dangerous bill and has nothing to do with \nfighting fraud and everything to do with orchestrating a huge privacy \ndata power grab from the American people.",
      "summary": "a dangerous bill and has nothing to do with fighting fraud and everything to do with orchestrating a huge privacy data power grab from the American people",
      "index": 1
    }
  ],
