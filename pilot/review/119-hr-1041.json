  "points": [
    {
      "debateScope": "general",
      "bio": "B001295",
      "speaker": "Mike Bost",
      "side": "Yea",
      "manager": true,
      "url": "https://www.govinfo.gov/content/pkg/CREC-2026-05-21/html/CREC-2026-05-21-pt1-PgH3684-5.htm",
      "start": 7883,
      "quote": "VA reported them not because they committed a crime or because a \njudge or a medical professional determined they were a danger to \nthemselves or others. VA reported them to NICS simply because they \nneeded help managing their benefits.",
      "display": "VA reported them not because they committed a crime or because a judge or a medical professional determined they were a danger to themselves or others. VA reported them to NICS simply because they needed help managing their benefits.",
      "passageUrl": "https://www.govinfo.gov/content/pkg/CREC-2026-05-21/html/CREC-2026-05-21-pt1-PgH3684-5.htm#:~:text=VA%20reported%20them%20not%20because%20they%20committed%20a%20crime%20or%20because%20a%20judge%20or%20a%20medical%20professional%20determined%20they%20were%20a%20danger%20to%20themselves%20or%20others.%20VA%20reported%20them%20to%20NICS%20simply%20because%20they%20needed%20help%20managing%20their%20benefits.",
      "end": 8119,
      "sentenceIds": [
        "2.5",
        "2.6"
      ]
    },
    {
      "debateScope": "general",
      "bio": "E000246",
      "speaker": "Chuck Edwards",
      "side": "Yea",
      "manager": false,
      "url": "https://www.govinfo.gov/content/pkg/CREC-2026-05-21/html/CREC-2026-05-21-pt1-PgH3684-5.htm",
      "start": 46196,
      "quote": "This bill is about basic fairness and restoring a standard that \nrespects both our veterans and the Constitution. Under current \npractice, a veteran who simply needs help managing their VA benefits \ncan be reported to the FBI's background check system and lose their \nSecond Amendment rights without ever appearing before a judge.",
      "display": "This bill is about basic fairness and restoring a standard that respects both our veterans and the Constitution. Under current practice, a veteran who simply needs help managing their VA benefits can be reported to the FBI's background check system and lose their Second Amendment rights without ever appearing before a judge.",
      "passageUrl": "https://www.govinfo.gov/content/pkg/CREC-2026-05-21/html/CREC-2026-05-21-pt1-PgH3684-5.htm#:~:text=This%20bill%20is%20about%20basic%20fairness%20and%20restoring%20a%20standard%20that%20respects%20both%20our%20veterans%20and%20the%20Constitution.%20Under%20current%20practice%2C%20a%20veteran%20who%20simply%20needs%20help%20managing%20their%20VA%20benefits%20can%20be%20reported%20to%20the%20FBI%27s%20background%20check%20system%20and%20lose%20their%20Second%20Amendment%20rights%20without%20ever%20appearing%20before%20a%20judge.",
      "end": 46526,
      "sentenceIds": [
        "20.2",
        "20.3"
      ]
    },
    {
      "debateScope": "general",
      "bio": "W000797",
      "speaker": "Debbie Wasserman Schultz",
      "side": "Nay",
      "manager": false,
      "url": "https://www.govinfo.gov/content/pkg/CREC-2026-05-21/html/CREC-2026-05-21-pt1-PgH3684-5.htm",
      "start": 26715,
      "quote": "Every day, 17 veterans die by suicide, and 13 of them use a firearm \nto take their lives. That number is simply unacceptable to me, as I \nknow it is to all of my colleagues, but I am deeply concerned that, \nwith this bill, we are about to make it worse.",
      "display": "Every day, 17 veterans die by suicide, and 13 of them use a firearm to take their lives. That number is simply unacceptable to me, as I know it is to all of my colleagues, but I am deeply concerned that, with this bill, we are about to make it worse.",
      "passageUrl": "https://www.govinfo.gov/content/pkg/CREC-2026-05-21/html/CREC-2026-05-21-pt1-PgH3684-5.htm#:~:text=Every%20day%2C%2017%20veterans%20die%20by%20suicide%2C%20and%2013%20of%20them%20use%20a%20firearm%20to%20take%20their%20lives.%20That%20number%20is%20simply%20unacceptable%20to%20me%2C%20as%20I%20know%20it%20is%20to%20all%20of%20my%20colleagues%2C%20but%20I%20am%20deeply%20concerned%20that%2C%20with%20this%20bill%2C%20we%20are%20about%20to%20make%20it%20worse.",
      "end": 26968,
      "sentenceIds": [
        "6.3",
        "6.4"
      ]
    },
    {
      "debateScope": "general",
      "bio": "M001234",
      "speaker": "Kelly Morrison",
      "side": "Nay",
      "manager": false,
      "url": "https://www.govinfo.gov/content/pkg/CREC-2026-05-21/html/CREC-2026-05-21-pt1-PgH3684-5.htm",
      "start": 42593,
      "quote": "While no silver bullet that will eradicate veteran suicide, making it \neasier for veterans suffering from severe mental illness or impairment \nto obtain a gun is not the answer.\n  H.R. 1041 creates serious risks for a group of veterans who are \nalready in a vulnerable position, and I cannot support it.",
      "display": "While no silver bullet that will eradicate veteran suicide, making it easier for veterans suffering from severe mental illness or impairment to obtain a gun is not the answer. H.R. 1041 creates serious risks for a group of veterans who are already in a vulnerable position, and I cannot support it.",
      "passageUrl": "https://www.govinfo.gov/content/pkg/CREC-2026-05-21/html/CREC-2026-05-21-pt1-PgH3684-5.htm#:~:text=While%20no%20silver%20bullet%20that%20will%20eradicate%20veteran%20suicide%2C%20making%20it%20easier%20for%20veterans%20suffering%20from%20severe%20mental%20illness%20or%20impairment%20to%20obtain%20a%20gun%20is%20not%20the%20answer.%20H.R.%201041%20creates%20serious%20risks%20for%20a%20group%20of%20veterans%20who%20are%20already%20in%20a%20vulnerable%20position%2C%20and%20I%20cannot%20support%20it.",
      "end": 42896,
      "sentenceIds": [
        "16.14",
        "16.15"
      ]
    }
